# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Database
MONGODB_URI=mongodb://localhost:27017

# Environment
ENVIRONMENT=development

STEAM_API_KEY=<your real key>
STEAM_LINKS=<your 5 discord_id:steamid pairs, comma-separated>

dont have a steam api key? get one here: https://steamcommunity.com/dev/apikey
also you dont have to use the steam api , discord rpc can also be used to get the game name and image, but it is less reliable than the steam api